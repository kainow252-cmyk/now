{
  "name": "now-ai-assistant",
  "version": "7.0.0",
  "description": "NOW AI - Assistente de voz inteligente com TTS nativo para Android",
  "main": "index.js",
  "scripts": {
    "cap:init": "cap init 'NOW AI' 'com.now.ai' --web-dir=frontend",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:build": "cap sync && cap copy && cap open android",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "install:deps": "npm install @capacitor/core @capacitor/cli @capacitor/android @capacitor-community/text-to-speech @capacitor-community/speech-recognition",
    "start": "node backend/server-v5.js"
  },
  "keywords": [
    "voice",
    "assistant",
    "ai",
    "tts",
    "speech-recognition",
    "android",
    "capacitor"
  ],
  "author": "kainow252-cmyk",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.5.0"
  }
}
