# ===================================
# NOW v4.0 - Environment Variables
# ===================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ===================================
# CRITICAL APIs (Required for full functionality)
# ===================================

# OpenAI API (ESSENTIAL - get at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Google Gemini API (ALTERNATIVE to OpenAI - get at https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Search API (for Learning & Internet Search)
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id

# ===================================
# OPTIONAL APIs (Work with mocks if not provided)
# ===================================

# Google Calendar API (get at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# News API (get at https://newsapi.org/register)
NEWS_API_KEY=your-news-api-key-32-chars

# Plaid (Banking) - Get at https://dashboard.plaid.com/signup
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Twitter/X API (get at https://developer.twitter.com/)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# LinkedIn API (get at https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ===================================
# SECURITY
# ===================================

# JWT Secret (CHANGE THIS! Use a strong random string)
JWT_SECRET=NOW-super-secret-jwt-key-change-this-2026

# ===================================
# DATABASE (Future - for production)
# ===================================

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/now_db

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# ===================================
# NOTES:
# ===================================
# 1. Copy this file to .env and fill in your real API keys
# 2. NEVER commit .env file to Git
# 3. See API_SETUP_GUIDE.md for detailed instructions
# 4. Yahoo Finance doesn't need API key (works out of the box)
